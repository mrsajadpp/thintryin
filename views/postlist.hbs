<div class="post-co" id="postConta">
    <div class="searchdiv" style="background-color: #060002;">
        <button id="navB" type="button">
            <box-icon type='solid' onclick="location.href = '/#{{post._id}}'" name='chevron-left'
                color="#6fbf7e"></box-icon>
        </button>
        <div></div>
    </div>
</div>
<div id="page">
    {{#if post}}
    <div id="{{post._id}}" class="tweet">
        <div class="tweet-container pt pb pr pl">
            <div class="user pr">
                <div class="userl" onclick="location.href = '/user/{{post.author.username}}'">
                    <div class="profile">
                        <img src="{{post.author.profile}}" onerror="this.src='/img/demopic.png'; post.onerror=null;" />
                    </div>
                    <div class="username">
                        <div class="name">{{post.author.firstname}} {{post.author.lastname}} &nbsp;{{#if
                            post.author.verified}}{{#if
                            post.author.official}}<box-icon type='solid' name='badge-check'
                                color="#6fbf7e"></box-icon>{{else}}<box-icon type='solid' name='badge-check'
                                color="#fff"></box-icon>{{/if}}{{/if}}
                        </div>
                        <div class="handle">@{{post.author.username}}</div>
                    </div>
                </div>
                <div class="userr">
                    <div class="follow">
                        <button class="bttwo post-menu" onclick="composeEmail()">
                            <box-icon name='flag-alt' type="solid" color="orange"></box-icon>
                        </button>
                    </div>
                </div>
                <script>
                    function composeEmail() {
                        var toAddress = "help@thintry.com";
                        var subject = "New post report!";

                        var postData = {
                            postID: "{{this._id}}",
                            content: "{{this.content}}",
                            timestamp: "{{this.timestamp}}",
                            upvotes: "{{this.upvote.length}}",
                            downvotes: "{{this.downvote.length}}"
                        };

                        var body = JSON.stringify(postData, null, 2); // Converts the postData object to a JSON string with formatting

                        var mailtoLink = "mailto:" + encodeURIComponent(toAddress) + "?subject=" + encodeURIComponent(subject) + "&body=" + encodeURIComponent(body);
                        window.location.href = mailtoLink;
                    }
                </script>
            </div>
            <div class="tweet-content pt">{{{parseContent post.content}}}
            </div>
            {{!-- <img class="media" src="https://i.giphy.com/media/26ufp2LYURTvL5PRS/giphy.webp" /> --}}
            <div class="date pt pb">{{#formatTime post.timestamp}}{{/formatTime}} • from
                <a href="https://www.google.com/maps/search/{{encodeURIComponent post.author.created.location.region}}"
                    title="Search on Google Maps">{{post.author.created.location.region}},
                    {{post.author.created.location.country}}</a>
            </div>

            <div class="rl pt pb">
                <div class="retweets"><b><span class="up-count" id="main-up-count-{{post._id}}">{{#formatNumber
                            post.upvote.length}}{{/formatNumber}}</span></b> Upvotes</div>
                <div class="likes"><b><span class="down-count" id="main-dow-count-{{post._id}}">{{#formatNumber
                            post.downvote.length}}{{/formatNumber}}</span></b> Downvotes</div>
            </div>
        </div>
        <div class="icons">
            <div class="ico"><box-icon name='message-square-add' color="#fff" class="img"></box-icon>
                <div class="number">{{#formatNumber post.replies.length}}{{/formatNumber}}</div>
            </div>
            <div class="ico">
                {{#includes post.upvote user._id}}
                <span id="up-{{post._id}}">
                    <box-icon type='solid' name='up-arrow' onclick="onVote('{{post._id}}', 'up', false)" color="#6fbf7e"
                        class="img"></box-icon>
                </span>
                <div class="number"><span id="up-count-{{post._id}}" class="up-count">{{#formatNumber
                        post.upvote.length}}{{/formatNumber}}</span>
                </div>
                {{else}}
                <span id="up-{{post._id}}">
                    <box-icon type='solid' name='up-arrow' onclick="onVote('{{post._id}}', 'up', false)" color="#fff"
                        class="img"></box-icon>
                </span>
                <div class="number"><span class="up-count" id="up-count-{{post._id}}">{{#formatNumber
                        post.upvote.length}}{{/formatNumber}}</span>
                </div>
                {{/includes}}
            </div>
            <div class="ico">
                {{#includes post.downvote user._id}}
                <span id="dow-{{post._id}}">
                    <box-icon name='down-arrow' type='solid' onclick="onVote('{{post._id}}', 'down', false)"
                        color="#6fbf7e" class="img"></box-icon>
                </span>
                <div class="number"><span id="dow-count-{{post._id}}" class="down-count">{{#formatNumber
                        post.downvote.length}}{{/formatNumber}}</span></div>
                {{else}}
                <span id="dow-{{post._id}}">
                    <box-icon name='down-arrow' type='solid' onclick="onVote('{{post._id}}', 'down', false)"
                        color="#fff" class="img"></box-icon>
                </span>
                <div class="number"><span id="dow-count-{{post._id}}" class="down-count">{{#formatNumber
                        post.downvote.length}}{{/formatNumber}}</span></div>
                {{/includes}}
            </div>
            {{#if isOwner}}
            <div class="ico"><box-icon type='solid' name='trash' color="red" onclick="delePost('{{post._id}}')"
                    color="#fff" class="img"></box-icon>
            </div>
            {{/if}}
            <div class="ico"><box-icon name='link' color="#fff" class="img"
                    onclick="copyLink('{{post._id}}')"></box-icon></div>
        </div>
    </div>
    {{!-- <form class="newpost" action="/post/reply" method="post">
        <div class="contentarea">
            <textarea style="background-color: #0e0e0e;" name="content" id="content" placeholder="What is happening?"
                maxlength="300" required></textarea>
            <input type="text" name="post_id" value="{{post._id}}" style="display: none;">
        </div>
        <div class="postsubmit">
            <button><box-icon type='solid' name='send'></box-icon></button>
        </div>
    </form> --}}
    {{#if post.replies}}
    {{#each post.replies}}
    {{#if this.content.length}}
    <div id="{{this._id}}" class="tweet">
        <div class="tweet-container pt pb pr pl">
            <div class="user pr">
                <div class="userl" onclick="location.href = '/user/{{this.author.username}}'">
                    <div class="profile">
                        <img src="{{this.author.profile}}" onerror="this.src='/img/demopic.png'; post.onerror=null;" />
                    </div>
                    <div class="username">
                        <div class="name">{{this.author.firstname}} {{this.author.lastname}} &nbsp;{{#if
                            this.author.verified}}{{#if
                            this.author.official}}<box-icon type='solid' name='badge-check'
                                color="#6fbf7e"></box-icon>{{else}}<box-icon type='solid' name='badge-check'
                                color="#fff"></box-icon>{{/if}}{{/if}}
                        </div>
                        <div class="handle">@{{this.author.username}}</div>
                    </div>
                </div>
            </div>
            <div class="tweet-content pt">{{{parseContent this.content}}}</div>
            {{!-- <img class="media" src="https://i.giphy.com/media/26ufp2LYURTvL5PRS/giphy.webp" /> --}}
            <div class="date pt pb">{{#formatTime this.timestamp}}{{/formatTime}} • from
                <a href="https://www.google.com/maps/search/{{encodeURIComponent this.author.created.location.region}}"
                    title="Search on Google Maps">{{this.author.created.location.region}},
                    {{this.author.created.location.country}}</a>
            </div>

            <div class="rl pt pb">
                <div class="retweets"><b><span class="up-count" id="main-up-count-{{this._id}}">{{#formatNumber
                            this.upvote.length}}{{/formatNumber}}</span></b> Upvotes</div>
                <div class="likes"><b><span class="down-count" id="main-dow-count-{{this._id}}">{{#formatNumber
                            this.downvote.length}}{{/formatNumber}}</span></b> Downvotes</div>
            </div>
        </div>
        <div class="icons">
            <div class="ico">
                {{#includes this.upvote ../user._id}}
                <span id="up-{{this._id}}">
                    <box-icon type='solid' name='up-arrow' onclick="onVote('{{this._id}}', 'up', true)" color="#6fbf7e"
                        class="img"></box-icon>
                </span>
                <div class="number"><span id="up-count-{{this._id}}" class="up-count">{{#formatNumber
                        this.upvote.length}}{{/formatNumber}}</span>
                </div>
                {{else}}
                <span id="up-{{this._id}}">
                    <box-icon type='solid' name='up-arrow' onclick="onVote('{{this._id}}', 'up', true)" color="#fff"
                        class="img"></box-icon>
                </span>
                <div class="number"><span class="up-count" id="up-count-{{this._id}}">{{#formatNumber
                        this.upvote.length}}{{/formatNumber}}</span>
                </div>
                {{/includes}}
            </div>
            <div class="ico">
                {{#includes this.downvote ../user._id}}
                <span id="dow-{{this._id}}">
                    <box-icon name='down-arrow' type='solid' onclick="onVote('{{this._id}}', 'down', true)"
                        color="#6fbf7e" class="img"></box-icon>
                </span>
                <div class="number"><span id="dow-count-{{this._id}}" class="down-count">{{#formatNumber
                        this.downvote.length}}{{/formatNumber}}</span></div>
                {{else}}
                <span id="dow-{{this._id}}">
                    <box-icon name='down-arrow' type='solid' onclick="onVote('{{this._id}}', 'down', true)" color="#fff"
                        class="img"></box-icon>
                </span>
                <div class="number"><span id="dow-count-{{this._id}}" class="down-count">{{#formatNumber
                        this.downvote.length}}{{/formatNumber}}</span></div>
                {{/includes}}
            </div>
            <div class="ico"><box-icon name='link' color="#fff" class="img"
                    onclick="copyLink('{{../post._id}}')"></box-icon></div>
            {{#ifEquals this.author._id ../user._id}}
            <div class="ico"><box-icon type='solid' name='trash' color="red" onclick="deleReply('{{this._id}}')"
                    color="#fff" class="img"></box-icon>
            </div>
            {{else}}
            <div class="ico"><box-icon name='flag-alt' type="solid" onclick="repReport('{{this}}')"
                    color="orange"></box-icon>
            </div>
            <script>
                function repReport(post) {
                    var toAddress = "help@thintry.com";
                    var subject = "New reply report!";

                    var postData = {
                        postID: post._id,
                        content: post.content,
                        timestamp: post.timestamp,
                        upvotes: post.upvote.length,
                        downvotes: post.downvote.length
                    };

                    var body = JSON.stringify(postData, null, 2); // Converts the postData object to a JSON string with formatting

                    var mailtoLink = "mailto:" + encodeURIComponent(toAddress) + "?subject=" + encodeURIComponent(subject) + "&body=" + encodeURIComponent(body);
                    window.location.href = mailtoLink;
                }
            </script>
            {{/ifEquals}}
        </div>
    </div>
</div>
{{/if}}
{{/each}}
{{/if}}
{{/if}}
</div>

<script>
    const successMessage = document.getElementById('btmsucc');
    let errorMessage = document.getElementById('btmerr');

    const onVote = async (postId, voteType, reply) => {
        try {
            let upBtn = document.getElementById('up-' + postId);
            let upVotes = document.getElementById('up-count-' + postId);
            let mainUpVotes = document.getElementById('main-up-count-' + postId);
            let dowBtn = document.getElementById('dow-' + postId);
            let dowVotes = document.getElementById('dow-count-' + postId);
            let mainDowVotes = document.getElementById('main-dow-count-' + postId);
            const response = await fetch(`/api/vote`, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                },
                body: JSON.stringify({ postId, voteType, reply: '{{post._id}}', ifreply: reply }),
            });

            if (response.ok) {
                const responseData = await response.json();
                if (responseData.error.status == 401) {
                    location.href = '/auth/login';
                } else {
                    if (responseData.error.status == 203) {
                        upBtn.innerHTML = `<box-icon type='solid' name='up-arrow' onclick="onVote('${postId}', 'up')" color="#6fbf7e"
                        class="img"></box-icon>`;
                        if (dowBtn.innerHTML == `<box-icon type="solid" name="down-arrow" onclick="onVote('64e70927ab6205d3b3dec94b', 'up')" color="#6fbf7e" class="img"></box-icon>`) {
                            dowBtn.innerHTML = `<box-icon type='solid' name='down-arrow' onclick="onVote('${postId}', 'up')" color="#fff"
                        class="img"></box-icon>`;
                            dowVotes.innerText = parseInt(dowVotes.innerText) - 1;
                            mainDowVotes.innerText = parseInt(mainDowVotes.innerText) - 1
                        }
                        upVotes.innerText = parseInt(upVotes.innerText) + 1;
                        mainUpVotes.innerText = parseInt(mainUpVotes.innerText) + 1
                    } else if (responseData.error.status == 204) {
                        upBtn.innerHTML = `<box-icon type='solid' name='up-arrow' onclick="onVote('${postId}', 'up')" color="#fff"
                        class="img"></box-icon>`;
                        upVotes.innerText = parseInt(upVotes.innerText) - 1;
                        mainUpVotes.innerText = parseInt(mainUpVotes.innerText) - 1
                    } else if (responseData.error.status == 205) {
                        dowBtn.innerHTML = `<box-icon type='solid' name='down-arrow' onclick="onVote('${postId}', 'up')" color="#6fbf7e"
                        class="img"></box-icon>`;
                        if (upBtn.innerHTML == `<box-icon type="solid" name="up-arrow" onclick="onVote('64e70927ab6205d3b3dec94b', 'up')" color="#6fbf7e" class="img"></box-icon>`) {
                            upBtn.innerHTML = `<box-icon type='solid' name='up-arrow' onclick="onVote('${postId}', 'up')" color="#fff"
                        class="img"></box-icon>`;
                            upVotes.innerText = parseInt(upVotes.innerText) - 1;
                            mainUpVotes.innerText = parseInt(mainUpVotes.innerText) - 1
                        }
                        dowVotes.innerText = parseInt(dowVotes.innerText) + 1;
                        mainDowVotes.innerText = parseInt(mainDowVotes.innerText) + 1
                    } else if (responseData.error.status == 206) {
                        dowBtn.innerHTML = `<box-icon type='solid' name='down-arrow' onclick="onVote('${postId}', 'up')" color="#fff"
                        class="img"></box-icon>`;
                        upBtn.innerHTML = `<box-icon type='solid' name='up-arrow' onclick="onVote('${postId}', 'up')" color="#fff"
                        class="img"></box-icon>`;
                        dowVotes.innerText = parseInt(dowVotes.innerText) - 1;
                        mainDowVotes.innerText = parseInt(mainDowVotes.innerText) - 1
                    } else {
                        errorMessage.textContent = 'Internal server error!'
                        errorMessage.classList.add('active');
                        setTimeout(() => {
                            errorMessage.classList.remove('active');
                        }, 3000);
                    }
                }
            }
        } catch (error) {
            console.error('Error while voting:', error);
        }
    }

    const copyLink = async (postId) => {
        try {
            await navigator.clipboard.writeText('https://thintry.com/post/' + postId);
            successMessage.textContent = 'Copied the link';
            successMessage.classList.add('active');
            setTimeout(() => {
                successMessage.classList.remove('active');
            }, 3000);
        } catch (error) {
            // Fallback for browsers that don't support Clipboard API
            const tempTextArea = document.createElement('textarea');
            tempTextArea.value = 'https://thintry.com/post/' + postId;
            document.body.appendChild(tempTextArea);
            tempTextArea.select();
            document.execCommand('copy');
            document.body.removeChild(tempTextArea);

            successMessage.textContent = 'Link copied';
            successMessage.classList.add('active');
            setTimeout(() => {
                successMessage.classList.remove('active');
            }, 3000);
        }
    };

    const delePost = async (postId) => {
        try {
            const confirmed = window.confirm("Are you sure you want to delete this post?");
            if (confirmed) {
                let post = document.getElementById(postId);
                const response = await fetch('/api/post/delete', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({ postId }) // Send profileId as JSON in the request body
                });

                if (response.ok) {
                    const responseData = await response.json();
                    if (responseData.error.status == 401) {
                        location.href = '/auth/login';
                    }
                    if (responseData.error.status == 500) {
                        errorMessage.innerHTML = responseData.error.message;
                        errorMessage.classList.add('active');
                        setTimeout(() => {
                            errorMessage.classList.remove('active')
                        }, 3000)
                    }

                    if (responseData.error.status == 200) {
                        location.href = '/';
                    }
                    // You can update UI or take other actions based on the response
                } else {
                    console.error('Follow API error:', response.statusText);
                }
            }
        } catch (error) {
            console.error('Error while making API call:', error);
        }
    }

    const deleReply = async (replyId) => {
        try {
            const confirmed = window.confirm("Are you sure you want to delete this reply?");
            if (confirmed) {
                let post = document.getElementById(replyId);
                const response = await fetch('/api/reply/delete', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({ replyId }) // Send profileId as JSON in the request body
                });

                if (response.ok) {
                    const responseData = await response.json();
                    if (responseData.error.status == 401) {
                        location.href = '/auth/login';
                    }
                    if (responseData.error.status == 500) {
                        errorMessage.innerHTML = responseData.error.message;
                        errorMessage.classList.add('active');
                        setTimeout(() => {
                            errorMessage.classList.remove('active')
                        }, 3000)
                    }

                    if (responseData.error.status == 200) {
                        post.remove();
                        successMessage.textContent = 'Post deleted';
                        successMessage.classList.add('active');
                        setTimeout(() => {
                            successMessage.classList.remove('active')
                        }, 3000)
                    }
                    // You can update UI or take other actions based on the response
                } else {
                    console.error('Follow API error:', response.statusText);
                }
            }
        } catch (error) {
            console.error('Error while making API call:', error);
        }
    }
</script>

