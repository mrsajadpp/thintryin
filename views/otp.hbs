<div class="loginForm">
    <div class="bannerArea">
        <img src="/img/thintry-logo.png" alt="">
    </div>
    <div class="inputs">
        <form action="/auth/verify" method="post">
            <div class="input">
                <input type="number" class="noerror-inp" name="otp" id="otp" placeholder="Verification Code" required autocomplete="off">
            </div>
            <input type="text" name="encrypted" value="{{encrypted}}" hidden>
            <input type="text" name="uid" value="{{uid}}" hidden>
            {{#if error}}
            <script>
                const otpp = document.getElementById('otp');
                otpp.classList.replace('noerror-inp', 'error-inp');
            </script>
            <div id="serverError" class="servererror">{{error.message}}</div>
            {{/if}}
            <div class="loginbtn">
                <button>Verify</button>
            </div>
            <div class="textarea">
                <span>Check your email box?.</span>
            </div>
        </form>
    </div>
</div>