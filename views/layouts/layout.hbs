<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="{{description}}">
  <meta name="keywords" content="{{keywords}},thintry,social,media,microblog,trending,">
  {{#if ogimage}}
  <meta property="og:image" content="{{ogimage}}">
  {{else}}
  <meta property="og:image" content="https://thintry.com/img/ogimage.png">
  {{/if}}
  {{#contains 'user' page}}
  <meta property="og:type" content="profile">
  <script type="application/ld+json">
        {
            "@context": "http://schema.org",
            "@type": "Person",
            "name": "{{profile.firstname}} {{profile.lastname}}",
            "jobTitle": "{{profile.job_title}}",
            "url": "https://thintry.com/user/{{profile.username}}",
            "sameAs": [
                "{{profile.links.facebook}}",
                "{{profile.links.twitter}}",
                "{{profile.links.linkedin}}"
            ],
            "image": "{{profile.profile}}"
        }
  </script>
  {{else}}
  <meta property="og:type" content="website">
  {{/contains}}
  <meta property="og:url" content="" id="og-url">
  <meta property="og:site_name" content="Thintry">
  <title>{{title}}</title>
  <script>
    document.getElementById('og-url').setAttribute('content', window.location.href);
  </script>
  <link rel="apple-touch-icon" href="/img/apple-touch.png">
  <!--CDN-->
  <script src="https://cdn.lordicon.com/bhenfmcm.js"></script>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/css/bootstrap.min.css" rel="stylesheet"
    integrity="sha384-EVSTQN3/azprG1Anm3QDgpJLIm9Nao0Yz1ztcQTwFspd3yD65VohhpuuCOmLASjC" crossorigin="anonymous">
  <link href='https://unpkg.com/boxicons@2.1.4/css/boxicons.min.css' rel='stylesheet'>
  <!--<script src="https://cdn.fluidplayer.com/v3/current/fluidplayer.min.js"></script>-->
  <link rel="stylesheet" href="/css/style.css">
  {{#if style}}
  <link rel="stylesheet" href="/css/{{style}}.css">
  {{/if}}
  <style>
    html,
    body {
      background: #060002;
      margin: 0;
      padding: 0;
      width: 100%;
      font-family: roboto;
      scroll-behavior: smooth;
    }
  </style>
</head>

<body>
   {{#if noload}}
   <div class="loader"></div>
  <script>
    console.log("Done.")
  </script>
  {{else}}
  {{>loading}}
  {{/if}}
  <div class="error-message" id="btmerr">This is a sample error message.</div>
  <div class="succes-message" id="btmsucc">This is a sample succes message.</div>
  {{#contains 'nohead' page}}
  <div id="contents" style="display: none;">
    {{{body}}}
  </div>
  {{else}}
  <div id="contents" style="display: none;">
    {{>header}}
    {{{body}}}
    {{>footer}}
    {{>search}}
    {{>post}}
  </div>
  {{/contains}}
  <script>
    window.addEventListener('load', function () {
        var loader = document.querySelector('.loader');
        let footer = document.getElementById('footer');
        let contents = document.getElementById('contents');
        setTimeout(() => {
            loader.style.display = 'none';
            contents.style.removeProperty("display");
        }, 100)
    });
</script>
